# Groq API Key (get from https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Model Configuration (default: Qwen model on Groq)
GROQ_MODEL=qwen/qwen3.8-27b

# Fallback/Alternative Groq Models:
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_MODEL=llama-3.1-8b-instant

# Adjudication default verdict mode: guilty_not_guilty | entails_does_not_entail | liable_not_liable
DEFAULT_VERDICT_MODE=guilty_not_guilty
